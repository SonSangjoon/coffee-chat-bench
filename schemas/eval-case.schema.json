{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/eval/schemas/eval-case.schema.json",
  "title": "Generic Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_version",
    "case_id",
    "capability",
    "task",
    "starting_context",
    "explicit_inputs",
    "expected_capabilities",
    "forbidden_behaviors",
    "quality_rubric",
    "evaluation_methods"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "suite_version": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "capability": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "starting_context": {},
    "explicit_inputs": {},
    "declared_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "uniqueItems": true
    },
    "expected_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbidden_behaviors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "allowed_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "protected_state": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "quality_rubric": {
      "type": "array",
      "items": { "$ref": "#/$defs/rubric" }
    },
    "evaluation_methods": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["deterministic", "semantic", "pairwise"] },
      "uniqueItems": true
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "claim"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "scale"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        }
      }
    }
  }
}
