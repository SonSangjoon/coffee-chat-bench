{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/eval/schemas/eval-report.schema.json",
  "title": "Generic Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "suite_version",
    "candidate",
    "status",
    "execution_order",
    "cases",
    "summary",
    "score_vector"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run_id": { "type": "string", "minLength": 1 },
    "suite_version": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "version", "source_ref", "adapter_version"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "enum": ["passed", "failed"] },
    "execution_order": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/evaluation_result" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "deterministic_failures", "semantic_failures"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "deterministic_failures": { "type": "integer", "minimum": 0 },
        "semantic_failures": { "type": "integer", "minimum": 0 }
      }
    },
    "score_vector": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mean", "max", "cases"],
        "properties": {
          "mean": { "type": "number" },
          "max": { "type": "number" },
          "cases": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "claim"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "detail"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 }
      }
    },
    "deterministic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed"],
      "properties": {
        "passed": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "failed": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "semantic_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "max", "rationale"],
      "properties": {
        "score": { "type": "number" },
        "max": { "type": "number" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "semantic": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "not-run" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "dimensions"],
          "properties": {
            "status": { "enum": ["passed", "failed"] },
            "dimensions": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/semantic_dimension" }
            },
            "failure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "cleanup": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "const": "clean" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "residuals"],
          "properties": {
            "status": { "const": "dirty" },
            "residuals": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "evaluation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "case_id",
        "candidate",
        "status",
        "output",
        "evidence",
        "actions",
        "trace",
        "deterministic",
        "semantic",
        "cleanup"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "case_id": { "type": "string", "minLength": 1 },
        "candidate": { "$ref": "#/$defs/candidate" },
        "status": { "enum": ["passed", "failed"] },
        "output": {},
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "trace": { "type": "array", "items": { "$ref": "#/$defs/trace" } },
        "deterministic": { "$ref": "#/$defs/deterministic" },
        "semantic": { "$ref": "#/$defs/semantic" },
        "cleanup": { "$ref": "#/$defs/cleanup" },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "version", "source_ref", "adapter_version"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_ref": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
