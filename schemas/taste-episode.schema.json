{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/bench/schemas/taste-episode.schema.json",
  "title": "Viewpoint-Conditioned Taste Episode",
  "$comment": "Runtime validation additionally enforces unique candidate_id/source_id keys and complete score maps, which standard JSON Schema cannot express generically for arrays and maps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_version",
    "episode_id",
    "evaluation_split",
    "capability",
    "task",
    "context",
    "factual_evidence",
    "target_evidence",
    "candidates",
    "control",
    "allowed_actions",
    "sealed_judgment"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "suite_version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "evaluation_split": { "enum": ["public", "held-out", "sealed"] },
    "capability": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "task": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "context": {},
    "factual_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "uniqueItems": true
    },
    "target_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/candidate" },
      "uniqueItems": true
    },
    "control": { "$ref": "#/$defs/control" },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" },
      "uniqueItems": true
    },
    "pair": { "$ref": "#/$defs/pair" },
    "sealed_judgment": { "$ref": "#/$defs/judgment" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "claim"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "claim": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "label", "evidence_refs"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "label": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "uniqueItems": true
        },
        "attributes": {}
      }
    },
    "condition": {
      "enum": [
        "taste",
        "knowledge-only",
        "retrieval-only",
        "explicit-rule",
        "style"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition"],
      "properties": {
        "condition": { "$ref": "#/$defs/condition" },
        "matched_case_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence_budget": { "type": "integer", "minimum": 0 }
      }
    },
    "action": {
      "enum": ["select", "rank", "exclude", "hold", "ask"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "criterion_tags", "evidence_refs"],
      "properties": {
        "action": { "$ref": "#/$defs/action" },
        "selected_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "uniqueItems": true
        },
        "excluded_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "uniqueItems": true
        },
        "ordered_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "uniqueItems": true
        },
        "criterion_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "criterion": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "uniqueItems": true
        },
        "uncertainty": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level"],
          "properties": {
            "level": { "enum": ["low", "medium", "high"] },
            "note": { "type": "string", "minLength": 1, "pattern": "\\S" }
          }
        },
        "question": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "rationale": { "type": "string", "minLength": 1, "pattern": "\\S" }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": { "action": { "const": "select" } },
              "required": ["selected_ids"],
              "not": { "anyOf": [{ "required": ["ordered_ids"] }, { "required": ["question"] }] }
            },
            {
              "properties": { "action": { "const": "rank" } },
              "required": ["ordered_ids"],
              "not": { "anyOf": [{ "required": ["selected_ids"] }, { "required": ["excluded_ids"] }, { "required": ["question"] }] }
            },
            {
              "properties": { "action": { "const": "exclude" } },
              "required": ["excluded_ids"],
              "not": { "anyOf": [{ "required": ["selected_ids"] }, { "required": ["ordered_ids"] }, { "required": ["question"] }] }
            },
            {
              "properties": { "action": { "const": "hold" } },
              "not": { "anyOf": [{ "required": ["selected_ids"] }, { "required": ["excluded_ids"] }, { "required": ["ordered_ids"] }, { "required": ["question"] }] }
            },
            {
              "properties": { "action": { "const": "ask" } },
              "required": ["question"],
              "not": { "anyOf": [{ "required": ["selected_ids"] }, { "required": ["excluded_ids"] }, { "required": ["ordered_ids"] }] }
            }
          ]
        }
      ]
    },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "role", "perturbation", "expected_relation"],
      "properties": {
        "pair_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "role": { "enum": ["anchor", "contrast"] },
        "perturbation": { "enum": ["none", "irrelevant", "decision-relevant"] },
        "expected_relation": { "enum": ["same-decision", "different-decision", "independent"] }
      }
    },
    "acceptable_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision", "utility"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "decision": { "$ref": "#/$defs/decision" },
        "utility": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "score_map": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptable_decisions", "criterion_tags", "candidate_utility", "omission_cost"],
      "properties": {
        "acceptable_decisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/acceptable_decision" }
        },
        "criterion_tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "candidate_utility": { "$ref": "#/$defs/score_map" },
        "omission_cost": { "$ref": "#/$defs/score_map" }
      }
    }
  }
}
