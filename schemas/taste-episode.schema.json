{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-chat.dev/eval/schemas/taste-episode.schema.json",
  "title": "Generic Taste Episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_version",
    "episode_id",
    "task",
    "factual_evidence",
    "candidates",
    "target_evidence",
    "context",
    "control_condition",
    "allowed_actions",
    "sealed_judgment"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "suite_version": { "type": "string", "minLength": 1 },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "task": { "type": "string", "minLength": 1 },
    "factual_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "uniqueItems": true
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" },
      "uniqueItems": true
    },
    "target_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "uniqueItems": true
    },
    "context": { "$ref": "#/$defs/context" },
    "control_condition": { "$ref": "#/$defs/control_condition" },
    "allowed_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["select", "rank", "exclude", "hold", "ask"] },
      "uniqueItems": true
    },
    "decision": { "$ref": "#/$defs/decision_artifact" },
    "sealed_judgment": { "$ref": "#/$defs/sealed_judgment" }
  },
  "$defs": {
    "json_value": {
      "anyOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/json_value" } },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json_value" }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "claim"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "label",
        "factually_admissible",
        "evidence"
      ],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "factually_admissible": { "const": true },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" },
          "uniqueItems": true
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "audience": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "stakes": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "minLength": 1 },
        "variables": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/json_value" }
        }
      }
    },
    "control_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["knowledge-only", "retrieval-only", "explicit-rule", "style"]
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "decision_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "evidence_refs"],
      "properties": {
        "action": {
          "enum": ["select", "rank", "exclude", "hold", "ask"]
        },
        "candidate_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "criterion": { "type": "string", "minLength": 1 },
        "trade_off": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "uncertainty": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "artifact": { "$ref": "#/$defs/json_value" }
      }
    },
    "sealed_judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "package_id", "version", "digest"],
      "properties": {
        "status": { "const": "sealed" },
        "package_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 }
      }
    }
  }
}
